{
  "name": "assessoria-comercial-uema-pedreiras",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Landing page + painel administrativo (CMS) da Assessoria Comercial UEMA Pedreiras — Hono + Cloudflare Pages + D1.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/app.css -o ./public/static/app.css --minify",
    "build:js": "terser src/client/admin.js --compress --mangle --output public/static/admin.js",
    "build:assets": "npm run build:css && npm run build:js",
    "dev": "npm run build:assets && vite",
    "build": "npm run build:assets && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && wrangler pages dev dist --d1=webapp-production --local --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply webapp-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply webapp-production --remote",
    "db:seed:local": "wrangler d1 execute webapp-production --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute webapp-production --remote --file=./seed.sql",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "tailwindcss": "^3.4.17",
    "terser": "^5.36.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
